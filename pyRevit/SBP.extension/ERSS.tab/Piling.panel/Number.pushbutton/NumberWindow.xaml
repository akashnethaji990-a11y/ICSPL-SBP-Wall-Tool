<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Number piles (layout plan)" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="walls_tb" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="SOFT pile prefix:" VerticalAlignment="Center"/>
            <TextBox x:Name="soft_tb" Grid.Row="0" Grid.Column="1" Margin="0,3" Padding="4,3" TextChanged="refresh"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="HARD pile prefix:" VerticalAlignment="Center"/>
            <TextBox x:Name="hard_tb" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="4,3" TextChanged="refresh"/>
        </Grid>
        <RadioButton x:Name="continue_rb" GroupName="start" Margin="0,3" IsChecked="True" Checked="refresh"
                     Content="Continue from the last number (same level)"/>
        <RadioButton x:Name="new_rb" GroupName="start" Margin="0,3" Checked="refresh" Content="Start new at 1"/>

        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="Labels (tags in this view)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid x:Name="label_grid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tag type (shows Mark):" VerticalAlignment="Center"/>
            <ComboBox x:Name="tag_cb" Grid.Row="0" Grid.Column="1" Margin="0,3" SelectionChanged="refresh"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset from pile edge (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="offset_tb" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="4,3" Width="80"
                     HorizontalAlignment="Left" TextChanged="refresh"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Rotation:" VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                <RadioButton x:Name="rot_along" GroupName="rot" Margin="0,2,12,2" Checked="refresh"
                             Content="Along the wall"/>
                <RadioButton x:Name="rot_across" GroupName="rot" Margin="0,2,12,2" Checked="refresh" Content="Across"/>
                <RadioButton x:Name="rot_fixed" GroupName="rot" Margin="0,2,4,2" IsChecked="True" Checked="refresh"
                             Content="Fixed:" VerticalAlignment="Center"/>
                <TextBox x:Name="angle_tb" Width="46" Padding="3,1" TextChanged="refresh" Text="0"/>
                <TextBlock Text=" deg" VerticalAlignment="Center"/>
            </WrapPanel>
        </Grid>
        <TextBlock Text="Label side, per wall:" Margin="0,6,0,2"/>
        <StackPanel x:Name="side_panel"/>
        <TextBlock x:Name="labels_note" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#8A5A00" Visibility="Collapsed"/>

        <Border Background="#FFF6E5" BorderBrush="#E8C27A" BorderThickness="1" CornerRadius="3"
                Padding="10,8" Margin="0,12,0,0">
            <TextBlock x:Name="live_tb" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"/>
        </Border>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="Nothing is written yet: the next step shows a summary to confirm."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ok_btn" Content="Next" Width="90" Margin="0,0,8,0" IsDefault="True" Click="ok_click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Click="cancel_click"/>
        </StackPanel>
    </StackPanel>
</Window>
